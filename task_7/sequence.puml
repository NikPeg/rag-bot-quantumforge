@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 20
skinparam maxmessagesize 60

title Диаграмма последовательности: Обработка запроса в RAG-боте

actor Пользователь
participant "RAG-бот\n(evaluate.py)" as Bot
participant "Векторный\nиндекс\n(ChromaDB)" as Index
participant "Модель\nэмбеддингов" as Embeddings
participant "LLM\n(YandexGPT)" as LLM
participant "Лог-файл\n(logs.jsonl)" as Log

== Инициализация ==
Bot -> Bot: Загрузка золотого набора вопросов
Bot -> Bot: Инициализация RAGBot
Bot -> Index: Загрузка векторного индекса
Index --> Bot: Индекс загружен

== Обработка запроса ==
loop Для каждого вопроса из golden_questions.txt
    Пользователь -> Bot: Вопрос из золотого набора
    
    == Поиск релевантных чанков ==
    Bot -> Embeddings: Преобразование запроса в эмбеддинг
    Embeddings --> Bot: Вектор запроса
    
    Bot -> Index: Поиск похожих чанков (similarity_search)
    Index --> Bot: Список релевантных чанков
    
    alt Чанки найдены
        Bot -> Bot: Фильтрация злонамеренных чанков
        Bot -> Bot: Формирование промпта с контекстом
        
        == Генерация ответа ==
        Bot -> LLM: Промпт с контекстом и инструкциями
        LLM --> Bot: Сгенерированный ответ
        
        Bot -> Bot: Post-проверка безопасности ответа
    else Чанки не найдены
        Bot -> Bot: Формирование ответа "Я не знаю"
    end
    
    == Оценка ответа ==
    Bot -> Bot: Оценка успешности ответа
    note right: Проверка соответствия\nожидаемому результату\n(должен/не должен ответить)
    
    Bot -> Bot: Оценка полноты ответа
    note right: Анализ длины ответа\nи наличия информации
    
    == Логирование ==
    Bot -> Bot: Формирование записи лога
    Bot -> Log: Сохранение записи (JSONL)
    Log --> Bot: Запись сохранена
    
    Bot --> Пользователь: Результат оценки
end

== Анализ результатов ==
Bot -> Log: Чтение всех записей лога
Log --> Bot: Все записи лога

Bot -> Bot: Вычисление статистики
note right: - Общий процент успешности\n- Процент по категориям\n- Средняя полнота\n- Список неудачных запросов

Bot --> Пользователь: Отчёт с анализом

== Обработка ошибок ==
alt Ошибка при загрузке индекса
    Index --> Bot: Ошибка загрузки
    Bot --> Пользователь: Сообщение об ошибке
end

alt Ошибка при поиске
    Index --> Bot: Ошибка поиска
    Bot --> Bot: Формирование ответа "Я не знаю"
end

alt Ошибка при генерации ответа
    LLM --> Bot: Ошибка API
    Bot --> Пользователь: Сообщение об ошибке
end

alt Пустой индекс
    Index --> Bot: Индекс пуст
    Bot --> Bot: Все запросы возвращают "Я не знаю"
end

alt Невалидный чанк
    Index --> Bot: Чанк с ошибкой
    Bot -> Bot: Пропуск невалидного чанка
end

@enduml

